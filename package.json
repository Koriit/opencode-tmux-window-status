{
  "name": "@koriit/opencode-tmux-window-status",
  "version": "0.1.0",
  "description": "An OpenCode plugin that renames the current tmux window with a status icon reflecting the session state (busy, idle, needs attention, error).",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koriit/opencode-tmux-window-status.git"
  },
  "homepage": "https://github.com/Koriit/opencode-tmux-window-status#readme",
  "bugs": "https://github.com/Koriit/opencode-tmux-window-status/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "tmux",
    "window",
    "status"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.15.13",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
